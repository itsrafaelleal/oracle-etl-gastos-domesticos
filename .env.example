# Copie para .env e troque TODAS as senhas:  cp .env.example .env
# O .env é ignorado pelo Git.

# Imagem do Oracle Database Free (linha 23.x). Fixe uma tag específica
# em produção/homelab para builds reprodutíveis (ex.: gvenzl/oracle-free:23.9).
ORACLE_IMAGE=gvenzl/oracle-free:23

# Porta publicada no host (listener).
ORACLE_PORT=1521

# Senha de SYS/SYSTEM (usada somente no setup inicial).
ORACLE_PASSWORD=TroqueEstaSenha_Sys1

# Dono dos objetos do pipeline (RAW, STG, DW, CTL).
ORC_OWNER_PASSWORD=TroqueEstaSenha_Owner1

# Usuário somente leitura para o Power BI.
ORC_BI_PASSWORD=TroqueEstaSenha_Bi1

# Serviço do PDB (padrão da imagem Free).
ORACLE_PDB=FREEPDB1
